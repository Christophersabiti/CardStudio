# ---------------------------------------------------------------------------
# Card Studio environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project.
# In Vercel, add the same variables under Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose to the browser.
# Legacy public key supported for owner-scoped reads; not used for authentication.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preferred for new projects. Either this or the legacy anon key is needed.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC and never
# expose to the browser. Server endpoints verify the signed-in user and ownership
# before mutations; public readers return only published snapshots.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app, used to build shareable card links.
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Active brand preset: "neutral" | "pmi" | "sabtech"  (see lib/brand.ts)
NEXT_PUBLIC_BRAND=neutral

# Clerk development keys for local testing; production keys belong in Vercel.
# These must be active NAME=value assignments, not commented descriptions.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
