# ---------------------------------------------------------------------------
# Card Studio environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project.
# In Vercel, add the same variables under Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose to the browser.
# Not used by the MVP (all access is server-side) but kept for when you add auth.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC and never
# expose to the browser. The MVP uses this in server routes / server components to
# read and write cards without user login.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app, used to build shareable card links.
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Active brand preset: "neutral" | "pmi" | "sabtech"  (see lib/brand.ts)
NEXT_PUBLIC_BRAND=neutral
