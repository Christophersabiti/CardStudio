{
  "name": "card-studio",
  "version": "0.1.0",
  "private": true,
  "description": "White-label digital business card builder with vCard QR codes. Next.js + Supabase.",
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node tests/integration.mjs",
    "check:auth": "node scripts/check-auth-setup.mjs",
    "account:link": "node scripts/link-legacy-account.mjs",
    "start:local": "next start --hostname localhost --port 3000"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.1",
    "@supabase/supabase-js": "2.115.0",
    "html-to-image": "^1.11.11",
    "nanoid": "^5.0.7",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^20.16.11",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "4.23.13",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
